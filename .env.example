# Example environment variables for `blozhik` development
# Copy to `.env` and configure locally.

NODE_ENV=development
PORT=3030
JWT_SECRET=dev-secret
VITE_APP_ID=dev-app
VITE_OAUTH_PORTAL_URL=http://localhost:3030
OAUTH_SERVER_URL=http://localhost:3030

# Database configuration: default local sqlite file (recommended for local dev)
# Examples:
# DATABASE_URL=file:./blozhik.db
# DATABASE_URL=sqlite:///absolute/path/to/blozhik.db
# Or keep a simple path (supported): ./blozhik.db
DATABASE_URL=./blozhik.db

# Umami analytics (optional). Leave blank in development to disable analytics.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional Manus/OAuth config
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Optional S3 configuration for image uploads (avatars, post images)
# Without S3: Users can still paste image URLs from external hosting (imgur, imgbb, etc.)
# With S3: Users can upload images directly from their device
# See SETUP_S3.md for detailed setup instructions
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=your-secret-key
# Optional: For S3-compatible services (Cloudflare R2, DigitalOcean Spaces)
# S3_ENDPOINT=https://your-endpoint.com
